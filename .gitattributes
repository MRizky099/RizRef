# Normalize line endings across platforms
* text=auto

# Rust sources are UTF-8
*.rs text
*.toml text
*.md text

# Shell scripts run under bash on every CI runner, Windows included: a CRLF
# checkout would make bash read a carriage return as part of every command.
*.sh text eol=lf

# The macOS bundle plist is read by plutil and pinned by a test, byte for byte.
*.plist text eol=lf

# Binary assets
*.rizref binary
*.png binary
*.ico binary
*.icns binary
